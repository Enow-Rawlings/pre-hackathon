# ─────────────────────────────────────────────────────────────────────────────
# CampusFix — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (no trailing slash)
VITE_API_URL=https://pre-hackathon-8c10.onrender.com

# Cloudinary unsigned upload configuration.
# Create an unsigned upload preset in Cloudinary dashboard → Settings → Upload Presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─── Notes ───────────────────────────────────────────────────────────────────
# - All VITE_ prefixed variables are bundled into the client at build time.
# - Never put secrets (API keys with write access, DB credentials) here.
# - The Cloudinary unsigned preset is intentionally public — it only allows
#   uploads and is restricted by your allowed file types / size in Cloudinary.
